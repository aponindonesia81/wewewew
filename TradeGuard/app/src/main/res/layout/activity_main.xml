<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#090B14" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="◈ TradeGuard" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Quotex Risk Protection — Real Test Build" android:textColor="#9299B4" android:textSize="13sp" android:layout_marginTop="4dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="Status: OFF" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnAccessibility" android:text="1. Enable Accessibility" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnCapture" android:text="2. Start Screen Sensor" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnTestLock" android:text="TEST: Lock Quotex Now" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/btnClear" android:text="Reset Loss Streak / Unlock" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Protection settings" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="18sp" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<EditText android:id="@+id/lossLimit" android:hint="Loss limit (default 4)" android:inputType="number" android:text="4" android:textColor="#FFFFFF" android:textColorHint="#9299B4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/lockMinutes" android:hint="Lock minutes (default 3)" android:inputType="number" android:text="3" android:textColor="#FFFFFF" android:textColorHint="#9299B4" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<CheckBox android:id="@+id/zeroIsLoss" android:text="Treat 0.00 as LOSS" android:textColor="#FFFFFF" android:checked="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Result ROI (% of screen) — use this to point the sensor at the RESULT (P/L) area." android:textColor="#9299B4" android:textSize="13sp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><EditText android:id="@+id/roiLeft" android:hint="L 0" android:inputType="numberDecimal" android:text="45" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><EditText android:id="@+id/roiTop" android:hint="T 0" android:inputType="numberDecimal" android:text="35" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><EditText android:id="@+id/roiRight" android:hint="R 100" android:inputType="numberDecimal" android:text="100" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><EditText android:id="@+id/roiBottom" android:hint="B 100" android:inputType="numberDecimal" android:text="75" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
<TextView android:id="@+id/stats" android:text="Trades: 0 | Profit: 0 | Loss: 0 | Streak: 0" android:textColor="#FFFFFF" android:textSize="15sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Important: this test build does not connect to Quotex servers or place trades. It only reads the visible screen locally and places a protection overlay when the loss threshold is reached." android:textColor="#FFCC80" android:textSize="12sp" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
